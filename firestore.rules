rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (synchronized with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClinicalProject(data) {
      return data.keys().hasAll(['name', 'description', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.description is string && data.description.size() <= 1000
        && data.ownerId is string && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectMember(data) {
      return data.keys().hasAll(['projectId', 'email', 'name', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['projectId', 'userId', 'email', 'name', 'role', 'createdAt', 'updatedAt'])
        && data.projectId is string && isValidId(data.projectId)
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role in ['admin', 'investigador', 'capturador']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Project Role Helpers
    function isProjectOwner(projectId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isProjectMemberDoc(projectId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function isProjectAdmin(projectId) {
      return isProjectOwner(projectId)
        || (isProjectMemberDoc(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    // 5. Connectivity test document (signed-in read check)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // 6. Private User Profiles (PII isolated by UID)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
    }

    // 7. Clinical Projects & Per-Project Memberships
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn()
        && (existing().ownerId == request.auth.uid || isProjectMemberDoc(projectId));
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidClinicalProject(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidClinicalProject(incoming())
        && isProjectAdmin(projectId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      match /members/{memberId} {
        allow get: if isValidId(projectId) && isValidId(memberId) && isSignedIn()
          && (isProjectOwner(projectId) || isProjectMemberDoc(projectId) || request.auth.uid == memberId);
        allow list: if isValidId(projectId) && isSignedIn()
          && existing().projectId == projectId
          && existing().userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && isValidProjectMember(incoming())
          && incoming().projectId == projectId
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isProjectAdmin(projectId)
            || (
              get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
              && memberId == request.auth.uid
              && incoming().userId == request.auth.uid
              && incoming().role == 'admin'
            )
          );
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && isValidProjectMember(incoming())
          && isProjectAdmin(projectId)
          && incoming().projectId == existing().projectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'name', 'userId', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(memberId)
          && isProjectAdmin(projectId)
          && memberId != get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId;
      }
    }
  }
}
