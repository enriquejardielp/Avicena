{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado de usuario autenticado en Avicena (PII aislada por UID).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "UserProjectRef": {
      "title": "UserProjectRef",
      "description": "Índice privado de estudios clínicos a los que pertenece un usuario.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "coordinador", "investigador", "monitor_clinico", "estadistico", "admin_tecnico", "capturador"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "name", "description", "ownerId", "role", "createdAt", "updatedAt"]
    },
    "ProjectInvite": {
      "title": "ProjectInvite",
      "description": "Invitación por correo electrónico con caducidad para colaborar en un estudio clínico.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "projectOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "invitedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "coordinador", "investigador", "monitor_clinico", "estadistico", "admin_tecnico", "capturador"] },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "acceptedUid": { "type": "string", "maxLength": 128 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectName", "projectOwnerId", "invitedByUid", "email", "name", "role", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "ClinicalProject": {
      "title": "ClinicalProject",
      "description": "Estudio clínico creado por un investigador.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "ownerId", "createdAt", "updatedAt"]
    },
    "StudyGovernance": {
      "title": "StudyGovernance",
      "description": "Política de gobernanza, envío a IA externa, consentimiento activo y requisitos de autenticación por estudio.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aiEnabled": { "type": "boolean" },
        "aiAllowClinicalText": { "type": "boolean" },
        "aiAllowDatasetContext": { "type": "boolean" },
        "aiDpaConfirmed": { "type": "boolean" },
        "requireMfa": { "type": "boolean" },
        "requireActiveConsent": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "aiEnabled", "aiAllowClinicalText", "aiAllowDatasetContext", "aiDpaConfirmed", "requireMfa", "updatedBy", "updatedAt"]
    },
    "StudyLifecycle": {
      "title": "StudyLifecycle",
      "description": "Estado del ciclo de vida del estudio clínico (reclutamiento, cierre, bloqueo de base) y registro de enmiendas de protocolo.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studyStatus": { "type": "string", "enum": ["borrador", "reclutamiento", "seguimiento", "cerrado", "bloqueado", "archivado"] },
        "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "amendments": { "type": "array" },
        "lastStatusReason": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "studyStatus", "protocolVersion", "amendments", "updatedBy", "updatedByName", "updatedAt"]
    },
    "ProjectMetaIndex": {
      "title": "ProjectMetaIndex",
      "description": "Catálogo acotado de identificadores de recursos del estudio y contadores de shards para lectura directa por ID.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberIds": { "type": "array" },
        "datasetIds": { "type": "array" },
        "formIds": { "type": "array" },
        "inviteIds": { "type": "array" },
        "crfRecordIds": { "type": "array" },
        "crfVersionIds": { "type": "array" },
        "vaultIds": { "type": "array" },
        "consentIds": { "type": "array" },
        "auditLogIds": { "type": "array" },
        "lastAuditHash": { "type": "string", "maxLength": 128 },
        "analysisIds": { "type": "array" },
        "shardCounts": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "memberIds", "datasetIds", "formIds", "crfRecordIds", "analysisIds", "updatedAt"]
    },
    "MetaShard": {
      "title": "MetaShard",
      "description": "Bloque particionado (máximo 500 IDs) para escalabilidad de índices sin alcanzar el límite de 1 MiB de Firestore.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "enum": ["crfRecordIds", "crfVersionIds", "auditLogIds", "vaultIds", "consentIds", "queryIds", "deviationIds", "signatureIds"] },
        "shardIndex": { "type": "number" },
        "ids": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "kind", "shardIndex", "ids", "updatedAt"]
    },
    "MemberIndex": {
      "title": "MemberIndex",
      "description": "Índice privado por miembro para lectura directa por getDoc de sus propios registros CRF y mensajes IA sin consultas list.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "crfRecordIds": { "type": "array" },
        "chatMessageIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId", "crfRecordIds", "chatMessageIds", "updatedAt"]
    },
    "ProjectMember": {
      "title": "ProjectMember",
      "description": "Membresía activa y rol asignado a un usuario dentro de un estudio clínico compartido.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "coordinador", "investigador", "monitor_clinico", "estadistico", "admin_tecnico", "capturador"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "inviteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectOwnerId", "userId", "email", "name", "role", "createdAt", "updatedAt"]
    },
    "ClinicalDataset": {
      "title": "ClinicalDataset",
      "description": "Base de datos analítica pseudonimizada (importada por CSV/Excel o vinculada a un formulario CRF).",
