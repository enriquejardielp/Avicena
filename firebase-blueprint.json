        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "signatureId": { "type": "string", "maxLength": 128 }
      },
      "required": ["projectId", "recordId", "version", "newStatus", "previousData", "newData", "changedBy", "changedByName", "changedAt", "reason"]
    },
    "IdentityVaultEntry": {
      "title": "IdentityVaultEntry",
      "description": "Bóveda lógica aislada de correspondencia entre subjectPseudoId e identidad cifrada AES-256-GCM.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subjectPseudoId": { "type": "string", "minLength": 4, "maxLength": 64 },
        "blindIndex": { "type": "string", "minLength": 32, "maxLength": 128 },
        "sealedPayload": { "type": "object" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "subjectPseudoId", "blindIndex", "sealedPayload", "createdBy", "createdAt"]
    },
    "BlindIndexEntry": {
      "title": "BlindIndexEntry",
      "description": "Índice ciego HMAC-SHA256 sin PII para deduplicación O(1) de participantes por roles de captura.",
      "type": "object",
