        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "number" },
        "formVersion": { "type": "number" },
        "previousStatus": { "type": "string" },
        "newStatus": { "type": "string", "enum": ["borrador", "completado", "enviado", "verificado", "bloqueado"] },
        "previousData": { "type": "object" },
        "newData": { "type": "object" },
