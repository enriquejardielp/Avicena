        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "datasetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chunkIndex": { "type": "number" },
        "rows": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "datasetId", "chunkIndex", "rows", "updatedBy", "updatedAt"]
    },
    "ClinicalForm": {
      "title": "ClinicalForm",
