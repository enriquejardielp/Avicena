        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "severity": { "type": "string", "enum": ["menor", "mayor", "critica"] },
        "status": { "type": "string", "enum": ["abierta", "en_investigacion", "capa_en_curso", "cerrada"] },
        "occurredAt": { "type": "string", "minLength": 4, "maxLength": 64 },
        "detectedAt": { "type": "string", "minLength": 4, "maxLength": 64 },
        "impactAssessment": { "type": "string", "maxLength": 2000 },
        "capaPlan": { "type": "string", "maxLength": 2000 },
        "responsibleName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resolutionNotes": { "type": "string", "maxLength": 2000 },
        "reportedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reportedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "description", "severity", "status", "occurredAt", "detectedAt", "impactAssessment", "capaPlan", "responsibleName", "reportedBy", "reportedByName", "createdAt", "updatedAt"]
    },
    "ElectronicSignature": {
      "title": "ElectronicSignature",
      "description": "Manifiesto inmutable de aprobación electrónica con reautenticación reciente (trazabilidad 21 CFR Part 11; no QES eIDAS).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["crf_record", "study_lifecycle"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetVersion": { "type": "number" },
        "meaning": { "type": "string", "minLength": 3, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 500 },
        "signerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "signerRole": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authTimeUtc": { "type": "string", "minLength": 10, "maxLength": 64 },
        "signedAtUtc": { "type": "string", "minLength": 10, "maxLength": 64 },
        "attestationHash": { "type": "string", "minLength": 32, "maxLength": 128 },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "signatureLevel": { "type": "string", "enum": ["reauthenticated_hmac_attestation"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "targetType", "targetId", "meaning", "reason", "signerUid", "signerName", "signerRole", "authTimeUtc", "signedAtUtc", "attestationHash", "keyId", "signatureLevel", "createdAt"]
    }
  },
