      },
      "required": ["projectId", "subjectPseudoId", "protocolVersion", "documentTitle", "method", "status", "signedAt", "recordedBy", "recordedByName", "createdAt", "updatedAt"]
    },
    "ConsentState": {
      "title": "ConsentState",
