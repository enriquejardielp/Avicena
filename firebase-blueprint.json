        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectOwnerId", "formId", "datasetId", "seq", "data", "createdBy", "updatedBy", "createdAt", "updatedAt"]
    },
    "CrfVersion": {
      "title": "CrfVersion",
      "description": "Instantánea inmutable de modificaciones y transiciones de estado en un registro CRF.",
