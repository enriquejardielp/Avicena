        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectOwnerId", "datasetId", "name", "description", "fields", "createdBy", "createdAt", "updatedAt"]
    },
    "CrfRecord": {
      "title": "CrfRecord",
      "description": "Registro pseudonimizado de paciente capturado mediante CRF con control de estado y versión.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectOwnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "formId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "datasetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subjectPseudoId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["borrador", "completado", "enviado", "verificado", "bloqueado"] },
        "version": { "type": "number" },
        "formVersion": { "type": "number" },
        "lastChangeReason": { "type": "string", "maxLength": 500 },
        "lastSignatureId": { "type": "string", "maxLength": 128 },
        "seq": { "type": "number" },
        "data": { "type": "object" },
