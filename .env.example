# GEMINI_API_KEY: Clave de API de Google Gemini (solo servidor; nunca usar VITE_*).
# En AI Studio se inyecta desde Secrets; en Cloud Run / Render configúrala mediante Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto HTTP del servidor Express (por defecto 3000).
PORT=3000

# NODE_ENV: "development" | "production"
NODE_ENV="development"

# APP_ENV: Entorno lógico separado ("development" | "testing" | "staging" | "production")
APP_ENV="development"

# ALLOWED_ORIGINS: Lista separada por comas de orígenes CORS permitidos en producción
# Ejemplo: https://avicena-prod.ejemplo.org,https://app.hospital.org
ALLOWED_ORIGINS=""

# AUDIT_HMAC_SECRET: Clave secreta para cadena HMAC-SHA256 de auditoría (mín. 32 caracteres aleatorios en producción)
AUDIT_HMAC_SECRET="CHANGE_ME_AUDIT_HMAC_SECRET_32_CHARS_MIN"
AUDIT_HMAC_KEY_ID="aud-k1"
# AUDIT_HMAC_PREVIOUS_SECRETS: Anillo de claves previas para verificar cadenas tras rotación ("aud-k0:secret_anterior,...")
AUDIT_HMAC_PREVIOUS_SECRETS=""

# VAULT_ENCRYPTION_SECRET: Clave separada de la bóveda AES-256-GCM e índice ciego (obligatoria y distinta de AUDIT_HMAC_SECRET en producción)
VAULT_ENCRYPTION_SECRET="CHANGE_ME_VAULT_SECRET_32_CHARS_MIN"
VAULT_ENCRYPTION_KEY_ID="vault-k1"
# VAULT_PREVIOUS_SECRETS: Anillo de claves previas de bóveda ("vault-k0:secret_anterior,...")
VAULT_PREVIOUS_SECRETS=""

# WORM_AUDIT_STREAM_ENABLED: Emite eventos estructurados worm_audit_event a stdout para sumidero WORM Cloud Logging -> GCS Bucket Lock
WORM_AUDIT_STREAM_ENABLED="true"

# FIREBASE_APP_CHECK_ENFORCED: Indicador operativo para entorno con App Check activo en consola
FIREBASE_APP_CHECK_ENFORCED="false"

# SSO institucional (Opcional: Identity Platform OIDC/SAML Provider ID, ej. saml.hospital-sso o oidc.hospital)
VITE_INSTITUTIONAL_SSO_PROVIDER_ID=""
VITE_INSTITUTIONAL_SSO_LABEL="Acceso institucional (SSO)"
