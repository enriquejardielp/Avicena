# GEMINI_API_KEY: Clave de API de Google Gemini para el copiloto bioestadístico.
# En AI Studio se inyecta desde Secrets; en Render configúrala en Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto HTTP del servidor Express (Render inyecta PORT automáticamente; por defecto 3000).
PORT=3000

# NODE_ENV: "development" en local, "production" en Render.
NODE_ENV="development"

# AVICENA_DATA_FILE: Ruta opcional para persistir la base JSON (útil si montas un Render Disk en /var/data/avicena.json).
AVICENA_DATA_FILE=".avicena-data.json"
